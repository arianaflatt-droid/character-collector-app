rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only your Google account counts as the teacher. Put your email here.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'ariana.flatt@unbound.school';
    }

    // Anyone with the site can read characters and settings. Only you can change them.
    match /characters/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /students/{id} {
      // A student's page can read their own record (the long random link is the key),
      // but only you can list everyone, add students, or delete them.
      allow get: if true;
      allow list: if isTeacher();
      allow create, delete: if isTeacher();

      // Students can only change pull/keep data, and can't turn their used-pull counts back down.
      // Everything else (XP, series, name, bonus pulls) is yours alone.
      allow update: if isTeacher() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pullsUsed', 'bonusUsed', 'tray', 'collection', 'keeps', 'lastPull'])
        && request.resource.data.get('pullsUsed', 0) >= resource.data.get('pullsUsed', 0)
        && request.resource.data.get('bonusUsed', 0) >= resource.data.get('bonusUsed', 0)
      );
    }
  }
}
